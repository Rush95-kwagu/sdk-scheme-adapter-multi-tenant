# Copier vers lab/.env (ne pas committer lab/.env).
# just build charge ce fichier puis découvre les mcm-agent-*.

IN=11000
OUT=11001
MET=11040

OUTBOUND_COMPACT_RESPONSE=true

# JWS / mTLS — aligné sur mcm-agent (sdk.jws.sign / validateInbound, tls.outboundMutual).
# Inbound mTLS : rester false ici (TLS terminé au WAF, voir docs).
JWS_SIGN=true
VALIDATE_INBOUND_JWS=true
JWS_SIGN_PUT_PARTIES=false
VALIDATE_INBOUND_PUT_PARTIES_JWS=false
OUTBOUND_MUTUAL_TLS_ENABLED=true
INBOUND_MUTUAL_TLS_ENABLED=false
# 1 = vérifier la CA Hub (certs PM4ML). 0 = trou lab si la CA n’est pas encore dans le slice.
NODE_TLS_REJECT_UNAUTHORIZED=1

# false = pas de contrôle (curl nu). true = header X-API-Key obligatoire.
OUTBOUND_API_KEY_ENABLED=false
OUTBOUND_API_KEY=

# Rempli automatiquement par just build (ne pas éditer à la main).
# MGMT_API_WS_URLS=
